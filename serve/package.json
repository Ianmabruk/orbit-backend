{
  "name": "serve",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build && npm --workspace apps/worker run build",
    "test": "npm --workspace apps/web run test"
  }
}
