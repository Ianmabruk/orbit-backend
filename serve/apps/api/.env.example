PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serve_db?schema=public

# Brevo email and SMS configuration
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME="Your Business Name"

# SMS provider configuration (backend-only, optional until approved)
# Supported providers: none, twilio, brevo
# Brevo uses the same BREVO_API_KEY and SMS_SENDER_ID for the sender label or number
SMS_PROVIDER=brevo
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_API_KEY=
SMS_SENDER_ID=Serve
